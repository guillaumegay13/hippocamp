-import { deliver, Send } from "../deliver";
+import { deliver, RetryDelays, Send } from "../deliver";
 import { headerValue, verifyHmac } from "../lib/signature";
 import { RetryQueue } from "../queue";
 import { Delivery, Store } from "../store";
 
-export type SourceConfig = { secret: string; target: string };
+export type SourceConfig = { secret: string; target: string; retry?: RetryDelays };
 export type Sources = Record<string, SourceConfig>;
 
+// Rejects bad retry settings at startup instead of on the first failed delivery.
+export function validateSources(sources: Sources): Sources {
+  for (const [name, config] of Object.entries(sources)) {
+    const retry = config.retry ?? {};
+    for (const key of ["baseDelayMs", "maxDelayMs"] as const) {
+      const value = retry[key];
+      if (value !== undefined && !(typeof value === "number" && Number.isFinite(value) && value > 0)) {
+        throw new Error(`source "${name}": retry.${key} must be a positive number of milliseconds`);
+      }
+    }
+    if (retry.baseDelayMs !== undefined && retry.maxDelayMs !== undefined && retry.maxDelayMs < retry.baseDelayMs) {
+      throw new Error(`source "${name}": retry.maxDelayMs must be >= retry.baseDelayMs`);
+    }
+  }
+  return sources;
+}
+
+// Retry timing is looked up from the delivery's source, so the worker uses the current config for queued retries.
+export function retryDelaysFor(sources: Sources): (delivery: Delivery) => RetryDelays | undefined {
+  return (delivery) => sources[delivery.source]?.retry;
+}
