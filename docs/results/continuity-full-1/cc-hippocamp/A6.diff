+  // Looks up the retry timing for a delivery's endpoint; undefined means the defaults.
+  delaysFor?: (delivery: Delivery) => RetryDelays | undefined;
   now?: () => number;
 };
 
 export const MAX_ATTEMPTS = 5;
+export const DEFAULT_BASE_DELAY_MS = 100;
 
-// 100ms, 200ms, 400ms, 800ms: at most ~1.5s of waiting across 5 attempts (plus worker poll latency).
-const defaultBackoff = (retry: number) => 100 * 2 ** (retry - 1);
+// With the defaults: 100ms, 200ms, 400ms, 800ms, at most ~1.5s of waiting across 5 attempts (plus worker poll latency).
+export function backoffDelay(retry: number, delays: RetryDelays = {}): number {
+  const delay = (delays.baseDelayMs ?? DEFAULT_BASE_DELAY_MS) * 2 ** (retry - 1);
+  return Math.min(delay, delays.maxDelayMs ?? Infinity);
+}
 
 // Makes one attempt to forward a delivery. A 5xx with attempts left is put on the retry queue and the
 // delivery stays "pending"; anything else is final and is removed from the queue.
