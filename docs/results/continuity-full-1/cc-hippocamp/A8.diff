+// Position in the newest-first delivery order. id breaks ties between deliveries received in the same ms.
+export type ListCursor = { receivedAt: number; id: string }; // receivedAt in epoch ms
+
+// Newest first: receivedAt descending, then id descending.
+function newestFirst(a: Delivery, b: Delivery): number {
+  const byTime = b.receivedAt.getTime() - a.receivedAt.getTime();
+  return byTime !== 0 ? byTime : a.id < b.id ? 1 : a.id > b.id ? -1 : 0;
+}
+
+function isAfter(delivery: Delivery, cursor: ListCursor): boolean {
+  const t = delivery.receivedAt.getTime();
+  return t < cursor.receivedAt || (t === cursor.receivedAt && delivery.id < cursor.id);
+}
+
 export interface Store {
   save(delivery: Delivery): Promise<void>;
   get(id: string): Promise<Delivery | undefined>;
   list(): Promise<Delivery[]>;
+  // Keyset page in newest-first order (receivedAt desc, id desc), strictly after `after` when given.
+  // Stable under concurrent inserts: new deliveries sort before any cursor already handed out.
+  listPage(limit: number, after?: ListCursor): Promise<Delivery[]>;
   recordAttempt(deliveryId: string, attempt: Attempt): Promise<void>;
   // Oldest first.
   attempts(deliveryId: string): Promise<Attempt[]>;
