+
+async function page(store: MemoryStore, query: string) {
+  const result = await handleAdmin("GET", `/admin/deliveries${query}`, auth, store, TOKEN);
+  assert.equal(result?.status, 200);
+  return { ids: (result!.body.deliveries as Array<{ id: string }>).map((d) => d.id), nextCursor: result!.body.nextCursor as string | null };
+}
+
+test("lists are a single page with a null cursor when everything fits", async () => {
+  assert.deepEqual(await page(await seeded(), ""), { ids: ["d2", "d1"], nextCursor: null });
+});
+
+test("walks pages with a cursor, breaking receivedAt ties by id", async () => {
+  const store = new MemoryStore();
+  // d-b, d-c and d-d share a millisecond, so the cursor must carry the id to split them.
+  for (const [id, at] of [["d-a", 1_000], ["d-b", 2_000], ["d-c", 2_000], ["d-d", 2_000], ["d-e", 3_000]] as const) {
+    await store.save(delivery(id, at));
+  }
+
+  const first = await page(store, "?limit=2");
+  assert.deepEqual(first.ids, ["d-e", "d-d"]);
+  const second = await page(store, `?limit=2&cursor=${first.nextCursor}`);
+  assert.deepEqual(second.ids, ["d-c", "d-b"]);
+  const third = await page(store, `?limit=2&cursor=${second.nextCursor}`);
+  assert.deepEqual(third, { ids: ["d-a"], nextCursor: null });
+});
+
+test("deliveries inserted while paging don't shift or repeat later pages", async () => {
+  const store = new MemoryStore();
+  for (let i = 1; i <= 4; i++) await store.save(delivery(`d${i}`, i * 1_000));
+
+  const first = await page(store, "?limit=2");
+  assert.deepEqual(first.ids, ["d4", "d3"]);
+  await store.save(delivery("d5", 5_000));
+  await store.save(delivery("d6", 6_000));
+  assert.deepEqual(await page(store, `?limit=2&cursor=${first.nextCursor}`), { ids: ["d2", "d1"], nextCursor: null });
+});
+
+test("an exact final page has a null cursor", async () => {
+  assert.deepEqual(await page(await seeded(), "?limit=2"), { ids: ["d2", "d1"], nextCursor: null });
+});
+
+test("defaults to 50 per page", async () => {
+  const store = new MemoryStore();
+  for (let i = 0; i < 51; i++) await store.save(delivery(`d${i}`, i));
+  const first = await page(store, "");
+  assert.equal(first.ids.length, 50);
+  assert.deepEqual(await page(store, `?cursor=${first.nextCursor}`), { ids: ["d0"], nextCursor: null });
+});
+
