+test("acme webhooks are verified with X-Acme-Signature", async () => {
+  const acme = { acme: { secret: "s3cret", target: "http://client.test/in", provider: "acme" as const } };
+  const body = JSON.stringify({ event: "order.created" });
+  const ok = async () => ({ ok: true, status: 200 });
+
+  const accepted = await handleWebhook("acme", body, { "x-acme-signature": sign(body) }, acme, new MemoryStore(), new MemoryRetryQueue(), ok);
+  assert.equal(accepted.status, 202);
+
+  // The generic header isn't accepted for an acme source, and a wrong signature is rejected.
+  const wrongHeader = await handleWebhook("acme", body, { "x-signature": sign(body) }, acme, new MemoryStore(), new MemoryRetryQueue(), ok);
+  assert.equal(wrongHeader.status, 401);
+  const wrongSig = await handleWebhook("acme", body, { "x-acme-signature": sign("{}") }, acme, new MemoryStore(), new MemoryRetryQueue(), ok);
+  assert.equal(wrongSig.status, 401);
+});
+
+test("an unknown provider stops startup", () => {
+  assert.throws(() => validateSources({ x: { secret: "s", target: "http://t", provider: "nope" as never } }), /unknown provider "nope"/);
