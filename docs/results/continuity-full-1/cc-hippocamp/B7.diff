-    return count
+    """Post deduped rows to the warehouse in chunks of at most chunk_size rows.
+
+    The next chunk is parsed while the previous one is being posted. Only one post
+    is in flight at a time, and chunks are posted in file order. If a post fails,
+    reading stops and the error is re-raised; nothing after the failed chunk is posted.
+    """
+    pending = queue.Queue(maxsize=1)
+    failure = []
+    posted = [0]
+
+    def poster():
+        while True:
+            chunk = pending.get()
+            if chunk is _DONE:
+                return
+            if failure:
+                continue  # drain without posting
+            try:
+                client.post_rows(chunk)
+                posted[0] += len(chunk)
+            except BaseException as error:
+                failure.append(error)
+
+    worker = threading.Thread(target=poster, name="ingest-poster", daemon=True)
+    worker.start()
+    try:
+        for chunk in chunked(dedupe(read(vendor, path)), chunk_size):
+            if failure:
+                break
+            pending.put(chunk)
+    finally:
+        pending.put(_DONE)
+        worker.join()
+        close = getattr(client, "close", None)
+        if close is not None:
+            close()
+    if failure:
+        raise failure[0]
+    return posted[0]
