 Everything stored in the warehouse is UTC, ISO-8601, e.g. "2025-03-04T13:22:10Z".
 Conversion to local time belongs in reports, never in ingest.
 """
+import re
 from datetime import datetime, timezone
+from functools import lru_cache
 from zoneinfo import ZoneInfo
 
 PARIS = ZoneInfo("Europe/Paris")
 
+# Fixed-width numeric directives: (datetime field, digits).
+_FAST_DIRECTIVES = {
+    "Y": ("year", 4),
+    "m": ("month", 2),
+    "d": ("day", 2),
+    "H": ("hour", 2),
+    "M": ("minute", 2),
+    "S": ("second", 2),
+}
+
+
+@lru_cache(maxsize=None)
+def _fast_parser(fmt):
+    """Compile `fmt` to a strict regex parser, or return None if it uses other directives.
+
+    The regex only accepts the exact zero-padded, fixed-width form. Anything else falls
+    back to strptime, so accepted inputs and errors are the same as strptime's.
+    """
+    pattern, fields, i = [], [], 0
+    while i < len(fmt):
+        if fmt[i] == "%":
+            spec = _FAST_DIRECTIVES.get(fmt[i + 1 : i + 2])
+            if spec is None or spec[0] in fields:
+                return None
+            fields.append(spec[0])
+            pattern.append(f"([0-9]{{{spec[1]}}})")
+            i += 2
+        else:
+            pattern.append(re.escape(fmt[i]))
+            i += 1
+    if not {"year", "month", "day"} <= set(fields):
+        return None
+    match = re.compile("".join(pattern)).fullmatch
+
+    def parse(value):
+        found = match(value)
+        if found is None:
+            return None
+        # datetime() validates ranges (month 13, Feb 30...) just like strptime.
+        return datetime(**{name: int(part) for name, part in zip(fields, found.groups())})
+
+    return parse
+
+
+def parse_naive(value, fmt):
+    fast = _fast_parser(fmt)
+    if fast is not None:
+        try:
+            parsed = fast(value)
+        except ValueError:
+            parsed = None  # let strptime raise its usual error
+        if parsed is not None:
+            return parsed
+    return datetime.strptime(value, fmt)
+
 
