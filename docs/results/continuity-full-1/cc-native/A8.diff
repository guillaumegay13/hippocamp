+export const DEFAULT_PAGE_SIZE = 50;
+export const MAX_PAGE_SIZE = 200;
+
+// Cursors are opaque to clients: base64url JSON of the last row's (receivedAt, id) keyset.
+export function encodeCursor(after: ListAfter): string {
+  return Buffer.from(JSON.stringify([after.receivedAt, after.id])).toString("base64url");
+}
+
+export function decodeCursor(cursor: string): ListAfter | undefined {
+  try {
+    const value: unknown = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
+    if (Array.isArray(value) && value.length === 2 && Number.isSafeInteger(value[0]) && typeof value[1] === "string") {
+      return { receivedAt: value[0], id: value[1] };
+    }
+  } catch {
+    // fall through
+  }
+  return undefined;
+}
+
+export type ListQuery = { cursor?: string | null; limit?: string | null };
+
+// Cursor-based (keyset) pagination, ordered by receivedAt then id, oldest first. Unlike offsets,
+// rows inserted while a client is paging never cause skips or duplicates.
+export async function listDeliveries(store: Store, query: ListQuery = {}): Promise<AdminResult> {
+  let limit = DEFAULT_PAGE_SIZE;
+  if (query.limit != null) {
+    limit = Number(query.limit);
+    if (!/^\d+$/.test(query.limit) || limit < 1 || limit > MAX_PAGE_SIZE) {
+      return { status: 400, body: { error: `limit must be an integer from 1 to ${MAX_PAGE_SIZE}` } };
+    }
+  }
+  let after: ListAfter | undefined;
+  if (query.cursor != null) {
+    after = decodeCursor(query.cursor);
+    if (!after) return { status: 400, body: { error: "invalid cursor" } };
+  }
+
+  // Fetch one extra row to learn whether another page exists.
+  const rows = await store.list({ after, limit: limit + 1 });
+  const page = rows.slice(0, limit);
+  const last = page[page.length - 1];
+  const nextCursor = rows.length > limit ? encodeCursor({ receivedAt: last.receivedAt.getTime(), id: last.id }) : null;
+  return { status: 200, body: { deliveries: page.map(toSummary), nextCursor } };
 }
 
