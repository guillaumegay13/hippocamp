diff --git a/ingest/timestamps.py b/ingest/timestamps.py
index 2954b13..a11af4e 100644
--- a/ingest/timestamps.py
+++ b/ingest/timestamps.py
@@ -25,3 +25,14 @@ def local_to_utc_iso(value, tz, fmt="%Y-%m-%d %H:%M:%S"):
     if local.astimezone(timezone.utc).astimezone(tz).replace(tzinfo=None) != naive:
         raise ValueError(f"{value!r} does not exist in {tz.key} (skipped by DST change)")
     return to_utc_iso(local)
+
+
+def offset_to_utc_iso(value):
+    """Convert an ISO-8601 string that carries its own UTC offset to UTC ISO-8601.
+
+    Strings without an offset are rejected rather than guessed at.
+    """
+    dt = datetime.fromisoformat(value)
+    if dt.tzinfo is None:
+        raise ValueError(f"{value!r} has no UTC offset")
+    return to_utc_iso(dt)
