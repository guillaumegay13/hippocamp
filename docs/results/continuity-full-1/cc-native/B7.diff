+@lru_cache(maxsize=8192)
+def _hour_offset(tz, hour_start):
+    """UTC offset shared by every wall-clock time in this local hour, or None.
+
+    None means the hour needs the per-value path: it is (partly) skipped by a
+    DST change, or the offset changes partway through it. Zones that change
+    offset on the hour (Europe/Paris does) get one computation per hour.
+    """
+    offsets = set()
