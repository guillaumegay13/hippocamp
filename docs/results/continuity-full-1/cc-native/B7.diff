 class Client:
-    def __init__(self, url):
+    """Posts row chunks to the warehouse HTTP API.
+
+    One HTTP(S) connection is kept open and reused for every chunk of a load,
+    so a big file pays for the TCP/TLS handshake once instead of once per chunk.
+    If the server closes the connection, the next chunk opens a new one. When
+    a proxy is configured for the URL (HTTP(S)_PROXY), requests go through
+    urllib instead, which handles the proxy.
+
+    Failed posts are not retried: a POST whose response was lost may still
+    have been stored, and posting it again could duplicate rows.
+    """
+
+    def __init__(self, url, timeout=30):
         self.url = url
+        self.timeout = timeout
+        parts = urlsplit(url)
+        if parts.scheme not in ("http", "https") or not parts.hostname:
+            raise ValueError(f"WAREHOUSE_URL must be an http(s) URL, got {url!r}")
+        self._parts = parts
+        self._path = (parts.path or "/") + (f"?{parts.query}" if parts.query else "")
+        proxies = urllib.request.getproxies()
+        self._use_proxy = parts.scheme in proxies and not urllib.request.proxy_bypass(parts.hostname)
+        self._conn = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+    def close(self):
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
 
