 import json
 from itertools import islice
 
-from ingest.reader import check_loadable, read
+from ingest.reader import VENDORS, check_loadable, read
 
 CHUNK_SIZE = 2_000
 
@@ -30,6 +30,22 @@ def dedupe(rows):
         yield {**row, "row_hash": row_hash(row)}
 
 
+def dedupe_keep_last(read_rows):
+    """Yield the last occurrence of each (vendor, order_id), in file order.
+
+    A later row for the same order is a correction and replaces the earlier
+    one. `read_rows` is called twice (two passes over the file): the first
+    pass records, per key, the position of its last row; the second yields
+    only those rows. As in `dedupe`, only keys are kept in memory.
+    """
+    last = {}
+    for index, row in enumerate(read_rows()):
+        last[(row["vendor"], row["order_id"])] = index
+    for index, row in enumerate(read_rows()):
+        if last.get((row["vendor"], row["order_id"])) == index:
+            yield {**row, "row_hash": row_hash(row)}
+
+
 def chunked(rows, size):
     iterator = iter(rows)
     while chunk := list(islice(iterator, size)):
@@ -43,8 +59,12 @@ def load_file(vendor, path, client, chunk_size=CHUNK_SIZE):
     (see `Vendor.hold`) are refused before anything is read or posted.
     """
     check_loadable(vendor)
+    if VENDORS[vendor].keep == "last":
+        rows = dedupe_keep_last(lambda: read(vendor, path))
+    else:
+        rows = dedupe(read(vendor, path))
     count = 0
-    for chunk in chunked(dedupe(read(vendor, path)), chunk_size):
+    for chunk in chunked(rows, chunk_size):
         client.post_rows(chunk)
         count += len(chunk)
     return count
