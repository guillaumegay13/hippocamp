--- a/test/deliver.test.ts
+++ b/test/deliver.test.ts
@@ -3,7 +3,7 @@ import assert from "node:assert/strict";
 import { createHmac } from "node:crypto";
 import { deliver, processDue } from "../src/deliver";
 import { MemoryRetryQueue } from "../src/queue";
-import { handleWebhook } from "../src/routes/webhooks";
+import { handleWebhook, validateSources } from "../src/routes/webhooks";
 import { Delivery, MemoryStore } from "../src/store";
 
 const sources = { github: { secret: "s3cret", target: "http://client.test/in" } };
@@ -146,3 +146,36 @@ test("signed webhook is stored and forwarded", async () => {
   assert.equal(result.status, 202);
   assert.equal((await store.list())[0].body, body);
 });
+
+test("a source's retry.baseDelayMs slows its retries, including queued ones", async () => {
+  const slow = { github: { ...sources.github, retry: { baseDelayMs: 5000 } } };
+  const store = new MemoryStore();
+  const queue = new MemoryRetryQueue();
+  const { send } = sequence(503, 503, 200);
+  // The handler's first attempt uses the real clock, so anchor the fake clock to it.
+  const t0 = Date.now();
+  let clock = t0;
+  const now = () => clock;
+
+  // First attempt goes through the webhook handler with the source's policy: next try in >= 5s.
+  const body = "{}";
+  await handleWebhook("github", body, { "x-signature": sign(body) }, slow, store, queue, send);
+  const [{ id }] = await store.list();
+  assert.deepEqual(await queue.claimDue(t0 + 4999, 10, 1), []);
+
+  // The worker looks the policy up by source, so the second retry is due 10s after the first.
+  const retryFor = (d: Delivery) => slow[d.source as "github"]?.retry;
+  clock = t0 + 6000;
+  assert.equal(await processDue(store, queue, send, { now, retryFor, leaseMs: 1 }), 1);
+  clock = t0 + 15_999;
+  assert.equal(await processDue(store, queue, send, { now, retryFor, leaseMs: 1 }), 0);
+  clock = t0 + 16_000;
+  assert.equal(await processDue(store, queue, send, { now, retryFor, leaseMs: 1 }), 1);
+  assert.equal((await store.get(id))?.status, "delivered");
+});
+
+test("validateSources rejects a bad retry.baseDelayMs", () => {
+  assert.throws(() => validateSources({ a: { secret: "s", target: "t", retry: { baseDelayMs: -1 } } }));
+  assert.throws(() => validateSources({ a: { secret: "s", target: "t", retry: { baseDelayMs: "5000" as any } } }));
+  validateSources({ a: { secret: "s", target: "t" }, b: { secret: "s", target: "t", retry: { baseDelayMs: 5000 } } });
+});
