 import { RetryQueue } from "../queue";
 import { Delivery, Store } from "../store";
 
-export type SourceConfig = { secret: string; target: string };
+export type SourceConfig = {
+  secret: string;
+  target: string;
+  // Optional per-source retry policy; falls back to the defaults in deliver.ts.
+  retry?: { baseDelayMs?: number };
+};
 export type Sources = Record<string, SourceConfig>;
 
 export type WebhookResult = { status: number; body: Record<string, unknown> };
@@ -40,6 +45,16 @@ export async function handleWebhook(
 
   await store.save(delivery);
   // First attempt is inline; any retries go through the queue and the worker.
-  const result = await deliver(delivery, store, queue, send);
+  const result = await deliver(delivery, store, queue, send, config.retry);
   return { status: 202, body: { id: result.id, status: result.status } };
 }
+
+// Throws if a source's retry settings are unusable (e.g. a negative or non-numeric delay).
+export function validateSources(sources: Sources): void {
+  for (const [name, config] of Object.entries(sources)) {
+    const baseDelayMs = config.retry?.baseDelayMs;
+    if (baseDelayMs !== undefined && !(typeof baseDelayMs === "number" && Number.isFinite(baseDelayMs) && baseDelayMs > 0)) {
+      throw new Error(`source "${name}": retry.baseDelayMs must be a positive number of milliseconds`);
+    }
+  }
+}
