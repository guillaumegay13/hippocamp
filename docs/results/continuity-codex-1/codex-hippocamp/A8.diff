+test("Postgres pagination uses a bounded tuple seek and retains microseconds", async () => {
+  const cursor = { receivedAt: "2026-11-09 08:00:00.123456+00", id: "a" };
+  const calls: { sql: string; values?: unknown[] }[] = [];
+  const store = new PostgresStore({ async query(sql, values) {
+    calls.push({ sql, values });
+    return { rows: ["b", "c"].map(id => ({ ...delivery, id, received_at: new Date(cursor.receivedAt), cursor_time: cursor.receivedAt })) };
+  } });
+  const page = await store.listPage(1, cursor);
+  assert.deepEqual(page.next, { ...cursor, id: "b" });
+  assert.deepEqual(calls[0].values, [cursor.receivedAt, "a", 2]);
+  assert.match(calls[0].sql, /WHERE \(received_at, id COLLATE "C"\) >/);
+  assert.match(calls[0].sql, /LIMIT \$3/);
+  assert.ok(!calls[0].sql.includes("body,"));
+  await store.listPage(2);
+  assert.deepEqual(calls[1].values, [3]);
+  assert.ok(!calls[1].sql.includes("WHERE"));
