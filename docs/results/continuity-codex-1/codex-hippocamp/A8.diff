+test("cursor pages handle ties, backfills, concurrent inserts and invalid input", async t => {
+  const store = new MemoryStore();
+  const server = createApp({}, store);
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  t.after(() => new Promise<void>(resolve => server.close(() => resolve())));
+  const address = server.address();
+  assert.ok(address && typeof address !== "string");
+  const base = `http://127.0.0.1:${address.port}/admin/deliveries`;
+  const save = (id: string, time: number) => store.save({ id, receivedAt: new Date(time), source: "s", target: "t", body: "secret", status: "pending", attempts: 0 });
+  await save("z", 2000);
+  await save("b", 1000); // Backfilled after a newer receipt.
+  await save("a", 1000);
+  const first = await (await fetch(`${base}?limit=1`)).json() as any;
+  assert.deepEqual(first.deliveries.map((d: any) => d.id), ["a"]);
+  await save("earlier", 500);
+  await save("c", 1000);
+  const second = await (await fetch(`${base}?limit=2&cursor=${first.nextCursor}`)).json() as any;
+  assert.deepEqual(second.deliveries.map((d: any) => d.id), ["b", "c"]);
+  const last = await (await fetch(`${base}?limit=2&cursor=${second.nextCursor}`)).json() as any;
+  assert.deepEqual(last.deliveries.map((d: any) => d.id), ["z"]);
+  assert.equal(last.nextCursor, null);
+  for (const query of ["limit=0", "limit=1001", "limit=1.5", "limit=1&limit=2", "cursor=", "cursor=garbage", "cursor=e30", "cursor=a&cursor=b"]) {
+    assert.equal((await fetch(`${base}?${query}`)).status, 400, query);
+  }
+});
