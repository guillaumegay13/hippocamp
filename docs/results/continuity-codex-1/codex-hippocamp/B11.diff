@@ -12,13 +12,12 @@ def row_hash(row):
 
 
 def iter_dedupe(rows):
-    """Keep the first occurrence of each (vendor, order_id), in file order."""
-    seen = set()
+    """Keep the last row per key, ordered by each key's first appearance."""
+    latest = {}
     for row in rows:
         key = (row["vendor"], row["order_id"])
-        if key in seen:
-            continue
-        seen.add(key)
+        latest[key] = row
+    for row in latest.values():
         yield {**row, "row_hash": row_hash(row)}
 
 
