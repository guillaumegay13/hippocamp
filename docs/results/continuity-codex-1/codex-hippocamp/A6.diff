index 0000000..7cc1481
--- /dev/null
+++ b/src/retry.ts
@@ -0,0 +1,10 @@
+export const DEFAULT_RETRY_DELAYS_MS = [100, 200, 400, 800] as const;
+
+export function retryDelays(value?: number[]): readonly number[] {
+  if (value === undefined) return DEFAULT_RETRY_DELAYS_MS;
+  if (!Array.isArray(value) || value.length !== 4 ||
+      value.some(delay => !Number.isSafeInteger(delay) || delay < 0 || delay > 2147483647)) {
+    throw new Error("retryDelaysMs must contain four integer delays between 0 and 2147483647 milliseconds");
+  }
+  return value;
+}
