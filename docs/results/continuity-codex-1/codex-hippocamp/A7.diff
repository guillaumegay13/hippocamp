index f95b332..4e336ab 100644
--- a/test/hmac.test.ts
+++ b/test/hmac.test.ts
@@ -30,3 +30,21 @@ test("queued webhook persists without sending and rejects invalid signatures wit
   assert.equal(saved.attempts, 0);
   assert.equal(result.body.receivedAt, saved.receivedAt.getTime());
 });
+
+test("Acme accepts its own header and rejects fallback headers or tampered bodies", async () => {
+  const store = new MemoryStore();
+  const sources = { acme: { secret: "acme-secret", target: "http://example.test" } };
+  const body = '{ "message": "hello é" }\n';
+  const signature = createHmac("sha256", sources.acme.secret).update(body).digest("hex");
+  for (const [rawBody, headers] of [
+    [body, { "x-signature": signature }],
+    [body.trim(), { "x-acme-signature": signature }],
+    [body, { "x-acme-signature": "invalid", "x-signature": signature }],
+  ] as const) {
+    assert.equal((await handleWebhook("acme", rawBody, headers, sources, store, undefined, true)).status, 401);
+  }
+  assert.equal((await store.list()).length, 0);
+  const result = await handleWebhook("acme", body, { "x-acme-signature": signature }, sources, store, undefined, true);
+  assert.equal(result.status, 202);
+  assert.equal((await store.list())[0].body, body);
+});
