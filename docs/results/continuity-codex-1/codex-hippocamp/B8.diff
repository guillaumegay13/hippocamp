@@ -0,0 +1,33 @@
+import json
+import unittest
+from unittest.mock import MagicMock, patch
+
+from ingest.warehouse import Client, MAX_REQUEST_BYTES, iter_request_bodies
+
+
+class WarehouseTest(unittest.TestCase):
+    def test_wide_rows_split_on_actual_wire_size_and_keep_order(self):
+        rows = [{"order_id": str(i), "sku": 'é"\\' * 1000} for i in range(1000)]
+        response = MagicMock()
+        response.__enter__.return_value.status = 200
+        with patch("ingest.warehouse.urllib.request.urlopen", return_value=response) as post:
+            Client("http://localhost/rows").post_rows(rows)
+        bodies = [call.args[0].data for call in post.call_args_list]
+        self.assertGreater(len(bodies), 1)
+        self.assertTrue(all(len(body) <= MAX_REQUEST_BYTES for body in bodies))
+        self.assertEqual([row for body in bodies for row in json.loads(body)["rows"]], rows)
+
+    def test_exact_limit_fits_and_one_more_byte_is_rejected(self):
+        empty_size = len(json.dumps({"rows": [{"sku": ""}]}).encode("utf-8"))
+        row = {"sku": "x" * (MAX_REQUEST_BYTES - empty_size)}
+        self.assertEqual(len(list(iter_request_bodies([row]))[0]), MAX_REQUEST_BYTES)
+        row["sku"] += "x"
+        with patch("ingest.warehouse.urllib.request.urlopen") as post:
+            with self.assertRaisesRegex(ValueError, "one warehouse row exceeds"):
+                Client("http://localhost/rows").post_rows([row])
+        post.assert_not_called()
+
+    def test_empty_input_sends_no_request(self):
+        with patch("ingest.warehouse.urllib.request.urlopen") as post:
+            Client("http://localhost/rows").post_rows([])
+        post.assert_not_called()
