 import json
 import urllib.request
 
+MAX_REQUEST_BYTES = 4_000_000
+
+
+def iter_request_bodies(rows):
+    """Split rows using the exact encoded JSON size, preserving their order."""
+    prefix, suffix = b'{"rows": [', b']}'
+    overhead = len(prefix) + len(suffix)
+    parts = []
+    size = overhead
+    for row in rows:
+        encoded = json.dumps(row).encode("utf-8")
+        if overhead + len(encoded) > MAX_REQUEST_BYTES:
+            raise ValueError("one warehouse row exceeds the 4 MB request limit")
+        extra = len(encoded) + (2 if parts else 0)
+        if size + extra > MAX_REQUEST_BYTES:
+            yield prefix + b', '.join(parts) + suffix
+            parts = []
+            size = overhead
+        size += len(encoded) + (2 if parts else 0)
+        parts.append(encoded)
+    if parts:
+        yield prefix + b', '.join(parts) + suffix
+
 
 class Client:
     def __init__(self, url):
         self.url = url
 
