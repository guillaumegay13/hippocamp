+export type DeliveryCursor = { receivedAt: number; id: string };
+export type ListOptions = { limit: number; after?: DeliveryCursor };
+
 export interface Store {
   recordAttempt(id: string, attempt: DeliveryAttempt): Promise<void>;
   listAttempts(id: string): Promise<DeliveryAttempt[]>;
   save(delivery: Delivery): Promise<void>;
   get(id: string): Promise<Delivery | undefined>;
-  list(): Promise<Delivery[]>;
+  list(options?: ListOptions): Promise<Delivery[]>;
 }
 
 export class MemoryStore implements Store {
@@ -52,7 +55,15 @@ export class MemoryStore implements Store {
     return delivery && { ...delivery };
   }
 
-  async list(): Promise<Delivery[]> {
-    return [...this.deliveries.values()].map((delivery) => ({ ...delivery }));
+  async list(options?: ListOptions): Promise<Delivery[]> {
+    let deliveries = [...this.deliveries.values()];
+    if (options) {
+      deliveries.sort((a, b) => a.receivedAt.getTime() - b.receivedAt.getTime() || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+      const after = options.after;
+      if (after) deliveries = deliveries.filter((d) => d.receivedAt.getTime() > after.receivedAt ||
+        (d.receivedAt.getTime() === after.receivedAt && d.id > after.id));
+      deliveries = deliveries.slice(0, options.limit);
+    }
+    return deliveries.map((delivery) => ({ ...delivery }));
   }
 }
