+test("admin pagination traverses equal timestamps and rejects invalid parameters", async (t) => {
+  const store = new Queue();
+  for (const id of ["c", "a", "b", "d"]) {
+    await store.save({ id, source: "github", target: "http://client.test/in", body: "private",
+      receivedAt: new Date(id === "d" ? 2000 : 1000), status: "pending", attempts: 0 });
+  }
+  const server = createServer(createRequestHandler({}, store));
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  t.after(() => new Promise<void>((resolve, reject) => {
+    server.close((error) => error ? reject(error) : resolve());
+    server.closeAllConnections();
+  }));
+  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}/admin/deliveries`;
+  const first = await (await fetch(`${base}?limit=2`)).json();
+  assert.deepEqual(first.items.map((d: { id: string }) => d.id), ["a", "b"]);
+  assert.equal(typeof first.nextCursor, "string");
+  // The cursor remains useful even if its delivery is removed or has changed status.
+  await store.save({ ...(await store.get("b"))!, status: "delivered" });
+  const second = await (await fetch(`${base}?limit=2&cursor=${first.nextCursor}`)).json();
+  assert.deepEqual(second.items.map((d: { id: string }) => d.id), ["c", "d"]);
+  assert.equal(second.nextCursor, null);
+  const end = Buffer.from(JSON.stringify([2000, "d"])).toString("base64url");
+  assert.deepEqual(await (await fetch(`${base}?cursor=${end}`)).json(), { items: [], nextCursor: null });
+  for (const query of ["limit=0", "limit=-1", "limit=1001", "limit=1.5", "limit=abc", "limit=", "limit=1&limit=2",
+    "cursor=", "cursor=bad", "cursor=e30", "cursor=WzAsMV0", "cursor=x&cursor=y"]) {
+    const response = await fetch(`${base}?${query}`);
+    assert.equal(response.status, 400, query);
+    assert.deepEqual(await response.json(), { error: "invalid pagination" });
+  }
+  const page = await (await fetch(base)).json();
+  assert.equal(page.items.length, 4);
+  assert.equal(JSON.stringify(page).includes("private"), false);
+});
