diff --git a/ingest/reader.py b/ingest/reader.py
index 7b20388..2527b72 100644
--- a/ingest/reader.py
+++ b/ingest/reader.py
@@ -29,6 +29,14 @@ def vendor_b_timestamp(value):
     return paris_timestamp(value, "%d/%m/%Y %H:%M")
 
 
+def vendor_c_timestamp(value):
+    """Normalize an ISO-8601 timestamp with an explicit offset to UTC."""
+    timestamp = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
+    if timestamp.tzinfo is None:
+        raise ValueError(f"missing UTC offset in vendor_c timestamp: {value!r}")
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
 @dataclass(frozen=True)
 class VendorSpec:
     encoding: str
@@ -55,6 +63,15 @@ VENDORS = {
             "created_at": ("date_commande", vendor_b_timestamp),
         },
     ),
+    "vendor_c": VendorSpec(
+        encoding="utf-8",
+        columns={
+            "order_id": ("orderNumber", str.strip),
+            "sku": ("productCode", str.strip),
+            "amount": ("totalPrice", float),
+            "created_at": ("orderedAt", vendor_c_timestamp),
+        },
+    ),
 }
 
 
