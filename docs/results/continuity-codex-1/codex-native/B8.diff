+def _source_encoding(path, spec):
+    if spec.fallback_encoding is None:
+        return spec.encoding
+    # Validate before yielding any rows: retrying after a decode failure could
+    # replay rows that the loader has already posted. Keep validation bounded.
+    decoder = codecs.getincrementaldecoder(spec.encoding)()
+    try:
+        with open(path, "rb") as handle:
+            while chunk := handle.read(64 * 1024):
+                decoder.decode(chunk)
+            decoder.decode(b"", final=True)
+    except UnicodeDecodeError:
+        return spec.fallback_encoding
+    return spec.encoding
+
+
 def _iter_rows(vendor, path, spec):
-    with open(path, newline="", encoding=spec.encoding) as handle:
