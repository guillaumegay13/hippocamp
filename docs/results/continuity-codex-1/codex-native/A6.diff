index ae195f7..3c4fe65 100644
--- a/test/queue.test.ts
+++ b/test/queue.test.ts
@@ -92,3 +92,29 @@ test("webhook cannot acknowledge a failed durable enqueue", async () => {
     provider: { secret: "secret", target: "http://target.test" },
   }, { enqueue: async () => { throw new Error("database unavailable"); } }), /database unavailable/);
 });
+
+test("endpoint retry delays survive queue recreation and resume at the persisted attempt", async (t) => {
+  const delays: number[] = [];
+  const originalSetTimeout = globalThis.setTimeout;
+  t.mock.method(globalThis, "setTimeout", (callback: () => void, delay: number) => {
+    delays.push(delay);
+    return originalSetTimeout(callback, 0);
+  });
+  const store = new FakeQueueStore();
+  const body = "{}";
+  const signature = createHmac("sha256", "secret").update(body).digest("hex");
+  for (const base of [1000, 2500]) {
+    const response = await handleWebhook("provider", body, { "x-signature": signature }, {
+      provider: { secret: "secret", target: `http://target.test/${base}`, retryDelayMs: base },
+    }, new DeliveryQueue(store));
+    const id = response.body.id as string;
+    assert.equal((await store.get(id))?.retryDelayMs, base);
+    // A new worker needs no source configuration to recover the accepted policy.
+    await new DeliveryQueue(store).processNext(async () => ({ ok: false, status: 503 }));
+    assert.deepEqual(delays.splice(0), [base, base * 2, base * 4, base * 8]);
+    const saved = (await store.get(id))!;
+    await store.save({ ...saved, status: "pending", attempts: 3 });
+    await new DeliveryQueue(store).processNext(async () => ({ ok: false, status: 503 }));
+    assert.deepEqual(delays.splice(0), [base * 8]);
+  }
+});
diff --git a/test/retry.test.ts b/test/retry.test.ts
new file mode 100644
index 0000000..a4c9bc6
--- /dev/null
+++ b/test/retry.test.ts
@@ -0,0 +1,11 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { retryDelayMs, MAX_RETRY_DELAY_MS } from "../src/retry";
+
+test("retry base delay defaults and timer-safe limits", () => {
+  assert.equal(retryDelayMs(undefined), 100);
+  for (const value of [0, 1000, MAX_RETRY_DELAY_MS]) assert.equal(retryDelayMs(value), value);
+  for (const value of [null, "1000", -1, 0.5, NaN, Infinity, MAX_RETRY_DELAY_MS + 1]) {
+    assert.throws(() => retryDelayMs(value), /retryDelayMs must be an integer/);
+  }
+});
