diff --git a/src/retry.ts b/src/retry.ts
new file mode 100644
index 0000000..cb9d956
--- /dev/null
+++ b/src/retry.ts
@@ -0,0 +1,11 @@
+export const DEFAULT_RETRY_DELAY_MS = 100;
+// The fourth wait is eight times the base; keep every wait within Node's timer limit.
+export const MAX_RETRY_DELAY_MS = Math.floor(2_147_483_647 / 8);
+
+export function retryDelayMs(value: unknown): number {
+  if (value === undefined) return DEFAULT_RETRY_DELAY_MS;
+  if (typeof value !== "number" || !Number.isInteger(value) || value < 0 || value > MAX_RETRY_DELAY_MS) {
+    throw new Error(`retryDelayMs must be an integer between 0 and ${MAX_RETRY_DELAY_MS}`);
+  }
+  return value;
+}
