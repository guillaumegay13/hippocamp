+def dedupe(rows, *, keep_last=False):
+    """Deduplicate on disk, preserving the order of first appearance.
+
+    Keeping the last occurrence requires staging the full input before yielding.
+    """
     with tempfile.TemporaryDirectory(prefix="ingest-") as directory:
         with closing(sqlite3.connect(str(Path(directory) / "seen.sqlite"))) as seen:
             seen.execute("PRAGMA cache_size = -2048")
