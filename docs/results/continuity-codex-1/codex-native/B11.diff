-                "CREATE TABLE seen (vendor TEXT, order_id TEXT, "
+                "CREATE TABLE seen (vendor TEXT, order_id TEXT, position INTEGER, payload TEXT, "
                 "PRIMARY KEY (vendor, order_id)) WITHOUT ROWID"
             )
-            for row in rows:
+            for position, row in enumerate(rows):
                 cursor = seen.execute(
-                    "INSERT OR IGNORE INTO seen VALUES (?, ?)",
-                    (row["vendor"], row["order_id"]),
+                    "INSERT INTO seen VALUES (?, ?, ?, ?) "
+                    "ON CONFLICT (vendor, order_id) DO UPDATE SET payload = excluded.payload"
+                    if keep_last else "INSERT OR IGNORE INTO seen VALUES (?, ?, ?, ?)",
+                    (row["vendor"], row["order_id"], position,
+                     json.dumps(row) if keep_last else None),
                 )
-                if cursor.rowcount:
+                if not keep_last and cursor.rowcount:
+                    yield {**row, "row_hash": row_hash(row)}
+            if keep_last:
+                for (payload,) in seen.execute("SELECT payload FROM seen ORDER BY position"):
+                    row = json.loads(payload)
                     yield {**row, "row_hash": row_hash(row)}
 
 
 def load_file(vendor, path, client):
     count = 0
-    with closing(iter_read(vendor, path)) as source, closing(dedupe(source)) as rows:
+    with closing(iter_read(vendor, path)) as source, closing(
+        dedupe(source, keep_last=vendor == "vendor_a")
+    ) as rows:
         while batch := list(islice(rows, BATCH_SIZE)):
             client.post_rows(batch)
             count += len(batch)
