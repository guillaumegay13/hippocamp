@@ -0,0 +1,31 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import { handleWebhook } from "../src/routes/webhooks";
+import { FakeQueueStore } from "./fake-queue-store";
+
+test("Acme verifies its signature header and preserves the signed body", async () => {
+  const body = '{ "message": "héllo" }\n';
+  const signature = createHmac("sha256", "secret").update(body).digest("hex");
+  const sources = { acme: { secret: "secret", target: "http://target.test" } };
+  const store = new FakeQueueStore();
+  const response = await handleWebhook("acme", body, { "x-acme-signature": signature }, sources, store);
+  assert.equal(response.status, 202);
+  assert.equal((await store.get(response.body.id as string))?.body, body);
+
+  for (const headers of [{}, { "x-signature": signature }, { "x-acme-signature": "bad" }]) {
+    assert.equal((await handleWebhook("acme", body, headers, sources, store)).status, 401);
+  }
+  assert.equal((await handleWebhook("acme", body + " ", { "x-acme-signature": signature }, sources, store)).status, 401);
+  assert.equal((await store.list()).length, 1);
+});
+
+test("other sources keep their existing signature header", async () => {
+  const body = "{}";
+  const signature = createHmac("sha256", "secret").update(body).digest("hex");
+  const sources = { provider: { secret: "secret", target: "http://target.test" } };
+  const store = new FakeQueueStore();
+  assert.equal((await handleWebhook("provider", body, { "x-signature": signature }, sources, store)).status, 202);
+  assert.equal((await handleWebhook("provider", body, { "x-acme-signature": signature }, sources, store)).status, 401);
+  assert.equal((await handleWebhook("unknown", body, {}, sources, store)).status, 404);
+});
